# Copy this file to .env and provide the real credential.
# Never commit .env — it is listed in .gitignore.
#
# CJ_EVAL_API_KEY is the only required secret.
# All other settings are declared in the YAML config files under
# evaluation/configs/ and take effect without any changes here.
#
# Precedence (highest → lowest):
#   exported shell variables  >  .env values  >  YAML values  >  defaults
#
# For local model servers (Ollama, vLLM) that do not require authentication,
# you may set:
#   CJ_EVAL_API_KEY=dummy

CJ_EVAL_API_KEY=
